PORT=3000
NODE_ENV=production

# Public application URL (must match Supabase Auth Site URL / Redirect URLs)
APP_URL=https://your-domain.example

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep secret and stable: existing encrypted user API keys depend on this value.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters

# Supabase project settings
SUPABASE_URL=https://zmtwidszfjzwuqjbeurr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Optional server-wide fallback API key. Prefer per-user tokens in the app settings.
AI_API_KEY=
AI_TIMEOUT_MS=240000
